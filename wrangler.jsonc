{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "totik-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",

  "keep_vars": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "DiscordGateway"
      }
    ]
  },

  "exports": {
    "DiscordGateway": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
